# Optional deployment base path.
# This project is configured for root deployments on Vercel.
VITE_APP_NAME="KGRCET Learning Portal"
VITE_API_BASE_URL=""

# Supabase Configuration
# Create a project at https://supabase.com
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_ANON_KEY="your-public-anon-key"

# Server-only keys for local seed scripts and Vercel API functions.
# Do not expose service role keys in client-side code.
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_ANON_KEY="your-public-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-for-local-seeding-only"

# If you connect Supabase through Vercel Marketplace, Vercel may provide:
# SUPABASE_PUBLISHABLE_KEY="your-publishable-key"
# SUPABASE_SECRET_KEY="your-secret-key"
