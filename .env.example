# Optional deployment base path.
# For normal domain/root deployments, leave Vite's configured base as ./.
# For a subpath deployment, update vite.config.ts base accordingly.
VITE_APP_NAME="KGRCET Learning Portal"
VITE_API_BASE_URL=""

# Supabase Configuration
# Create a project at https://supabase.com
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_ANON_KEY="your-public-anon-key"

# Server-only keys for local seed scripts and Vercel API functions.
# Do not expose service role keys in client-side code.
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_ANON_KEY="your-public-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-for-local-seeding-only"
