  "learning_records": [
    {
      "id": "learn-question-er-model",
      "kind": "question",
      "author_id": "u-faculty-demo",
      "subject_id": "sub-dbms-cse-a",
      "assignment_id": "act-dbms-er-model",
      "title": "Convert an ER model to relations",
      "body": "Explain how entities, keys, and a many-to-many relationship are converted into a relational schema.",
      "status": "active",
      "score": 10,
      "metadata": {
        "difficulty": "Medium",
        "tags": ["ER model", "relational schema"],
        "reference_answer": "Create one relation for each strong entity using its key as the primary key. Place a foreign key on the many side for one-to-many relationships and create an associative relation with both foreign keys for a many-to-many relationship.",
        "keywords": ["entity", "primary", "foreign", "relationship", "relation"]
      },
      "created_at": "2026-08-20T08:00:00.000Z",
      "updated_at": "2026-08-20T08:00:00.000Z"
    },
    {
      "id": "learn-question-sql",
      "kind": "question",
      "author_id": "u-faculty-demo",
      "subject_id": "sub-dbms-cse-a",
      "assignment_id": "act-dbms-sql-practice",
      "title": "Department-wise average salary",
      "body": "Write a query that returns each department name and its average employee salary, including only departments with an average above 50000.",
      "status": "active",
      "score": 10,
      "metadata": {
        "difficulty": "Medium",
        "tags": ["SQL", "JOIN", "GROUP BY"],
        "reference_answer": "Join departments and employees, group by department name, calculate AVG salary, and filter grouped results with HAVING AVG salary greater than 50000.",
        "keywords": ["join", "group", "average", "having", "department"]
      },
      "created_at": "2026-08-20T08:15:00.000Z",
      "updated_at": "2026-08-20T08:15:00.000Z"
    },
    {
      "id": "learn-question-normalization",
      "kind": "question",
      "author_id": "u-faculty-demo",
      "subject_id": "sub-dbms-cse-a",
      "assignment_id": "act-dbms-normalization-quiz",
      "title": "Identify a BCNF violation",
      "body": "Given R(A, B, C) with dependencies AB -> C and C -> B, identify the candidate keys and explain whether R is in BCNF.",
      "status": "active",
      "score": 10,
      "metadata": {
        "difficulty": "Hard",
        "tags": ["Normalization", "BCNF"],
        "reference_answer": "AB and AC are candidate keys. C determines B but C is not a superkey, so C -> B violates BCNF.",
        "keywords": ["candidate", "superkey", "dependency", "bcnf", "violation"]
      },
      "created_at": "2026-08-20T08:30:00.000Z",
      "updated_at": "2026-08-20T08:30:00.000Z"
    },
    {
      "id": "learn-question-transactions",
      "kind": "question",
      "author_id": "u-faculty-demo",
      "subject_id": "sub-dbms-cse-a",
      "assignment_id": "act-dbms-transactions",
      "title": "Test conflict serializability",
      "body": "Describe how a precedence graph is used to determine whether a schedule is conflict serializable.",
      "status": "active",
      "score": 10,
      "metadata": {
        "difficulty": "Medium",
        "tags": ["Transactions", "Serializability"],
        "reference_answer": "Create one node per transaction and an edge for each ordered conflicting operation. The schedule is conflict serializable exactly when the graph has no cycle.",
        "keywords": ["transaction", "conflict", "edge", "cycle", "serializable"]
      },
      "created_at": "2026-08-20T08:45:00.000Z",
      "updated_at": "2026-08-20T08:45:00.000Z"
    },
