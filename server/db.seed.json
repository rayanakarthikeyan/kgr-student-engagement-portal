      "subject_id": "sub-dbms-cse-a",
      "assignment_id": "act-dbms-sql-practice",
      "title": "Assignment support",
      "body": "Should the average salary condition be in WHERE or HAVING?",
      "status": "answered",
      "score": null,
      "metadata": {
        "assignment_title": "SQL Queries Practice",
        "model": "Built-in DBMS tutor",
        "response": "Use HAVING because the condition depends on AVG, which is calculated after grouping. WHERE filters individual rows before GROUP BY."
      },
